# Copy to .deploy.env (gitignored — never commit real host details) and fill in.
#   cp .deploy.env.example .deploy.env

# SSH target of the production panel server.
SSH_HOST=root@your.server.ip
SSH_PORT=22

# Where the app lives on that server.
REMOTE_PATH=/var/www/panel

# Service names to reload after code lands (see `systemctl list-units`).
FPM_SERVICE=php8.4-fpm
QUEUE_SERVICE=panel-queue.service
# Optional: long-running Telegram poller service (leave blank if you don't run one).
TELEGRAM_SERVICE=telegram-bot-poll.service

# Public URL for the post-deploy health check (leave blank to skip).
# Point this at a page that actually RENDERS and touches the DB, e.g. /login —
# NOT the bare domain. "/" merely 302s to login without rendering, so it stays
# "healthy" even when every real page is throwing 500.
HEALTH_URL=https://your.domain/login

# User php-fpm runs as; everything under REMOTE_PATH is chowned to it after
# deploy (rsync -a and root-run composer/artisan both break its write access).
WEB_USER=www-data
