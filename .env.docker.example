# Copy to .env before `docker compose up -d --build` (or `make up`):
#   cp .env.docker.example .env
# Then edit the lines marked CHANGE ME below.
# NOTE: keep comments on their own lines — never put "# ..." after a value,
# Docker parses that comment as part of the value.

APP_NAME=Polo
APP_ENV=production
# APP_KEY is auto-generated on first boot; leave it blank.
APP_KEY=
APP_DEBUG=false

# CHANGE ME: the public URL customers hit (include the port if not behind a
# reverse proxy). Mail links & payment callbacks are built from this.
APP_URL=http://localhost:8080

# CHANGE ME: the secret admin path (/<this>). Do NOT leave the default.
ADMIN_PANEL_PATH=change-me-to-something-random

# Optional multi-tenant subdomains. Leave blank for a single-site install.
TENANCY_PARENT_DOMAIN=
TENANCY_CENTRAL_DOMAINS=

APP_LOCALE=zh_CN
APP_FALLBACK_LOCALE=en
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=warning

# --- Database (the compose `db` service) ---
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=polo
DB_USERNAME=polo
# CHANGE ME (DB_PASSWORD must match what the db container is created with)
DB_PASSWORD=change-me-to-a-long-random-password
DB_ROOT_PASSWORD=change-me-to-another-long-random-password

# Everything runs on the DB driver — no Redis needed.
SESSION_DRIVER=database
SESSION_LIFETIME=120
QUEUE_CONNECTION=database
CACHE_STORE=database
FILESYSTEM_DISK=local
BROADCAST_CONNECTION=log

# Host port nginx is published on (http://localhost:<WEB_PORT>)
WEB_PORT=8080

# --- Mail (fill in to actually send expiry/reset emails) ---
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# --- Telegram bot (optional; also configurable in 系统配置) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
